# Ubuntu 22.04 构建环境
FROM ubuntu:22.04

ARG ARCH=amd64
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    pkg-config \
    git \
    ca-certificates \
    curl \
    wget \
    debhelper \
    devscripts \
    dpkg-dev \
    fakeroot \
    lintian \
    file \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
